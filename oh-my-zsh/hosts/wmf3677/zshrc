export VHR_REPO=$HOME/code/wmf/gitlab/product-safety-and-integrity/vulnhunt-record
export VHR_AGE_KEY_FILE=$HOME/.config/vhr/age.key
export VHR_RECIPIENTS_FILE=$HOME/.config/vhr/recipients
