# export SSH_AUTH_SOCK=/Users/alex/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh

# Only recreate the socket if we don't have one forwarded in.
if [[ -z $SSH_CONNECTION || ! -S $SSH_AUTH_SOCK  ]]
then
  export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"

  ssh-add -l >/dev/null 2>&1
  if [ $? -eq 2 ]; then
      rm -f "$SSH_AUTH_SOCK"
      /opt/homebrew/bin/ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null
  fi
fi

# wmf-claude setup
export VHR_REPO=$HOME/code/wmf/gitlab/product-safety-and-integrity/vulnhunt-record
export VHR_AGE_KEY_FILE=$HOME/.config/vhr/age.key
export VHR_RECIPIENTS_FILE=$HOME/.config/vhr/recipients
export PATH="$PATH:$HOME/code/wmf/gitlab/product-safety-and-integrity/wmf-claude/bin:$HOME/code/wmf/gitlab/product-safety-and-integrity/wmf-security-skills/bin"

# Default VM
export WMF_CLAUDE_VM=wmf-claude-cvp
